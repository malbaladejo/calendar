    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/CalendarWebApi/CalendarWebApi.csproj",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar/v1"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}
